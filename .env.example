# Copy this file to .env and fill in values. .env is git-ignored. Never commit real keys.

# --- Backend (never sent to the browser) ---
# Optional AI-written executive briefings. Set ONE key; without any key, briefings are built from templates.
# FREE: Google Gemini -> https://aistudio.google.com/apikey  (no credit card)
GEMINI_API_KEY=
# FREE: Groq -> https://console.groq.com/keys
GROQ_API_KEY=
# PAID: Claude -> https://console.anthropic.com -> Settings -> API Keys
ANTHROPIC_API_KEY=
# If several keys are set, pick one: gemini | groq | anthropic
# LLM_PROVIDER=gemini
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL=openai/gpt-oss-120b
# LLM_MODEL=claude-opus-5-5

# Database. Default: local SQLite file. PostGIS example (docker compose db service):
# DATABASE_URL=postgresql+psycopg://sitesense:sitesense@localhost:5433/sitesense
# Comma-separated allowed frontend origins (default: any)
# CORS_ORIGINS=https://your-frontend.example.com

# --- Frontend (VITE_* values are public: put no secrets here) ---
# Backend base URL. Leave empty locally (Vite proxies /api) and in Docker (nginx proxies /api).
# Set it when the frontend is hosted separately, e.g. VITE_BACKEND_URL=https://your-backend.onrender.com
VITE_BACKEND_URL=
# Where the Vite dev server proxies /api (default http://127.0.0.1:8000)
# DEV_API_PROXY=http://127.0.0.1:8000
# Optional custom map tiles; leave empty for OpenStreetMap.
# VITE_MAP_TILE_URL=
# VITE_MAP_ATTRIBUTION=
